BH_ENVIRONMENT=development
BH_DEBUG=true

# PostgreSQL / PostGIS connection (asyncpg uses this directly)
BH_DATABASE_URL=postgresql://bloodheroes:bloodheroes@localhost:5432/bloodheroes
BH_DB_POOL_MIN=1
BH_DB_POOL_MAX=10

# JWT
BH_JWT_SECRET=change-me-to-a-long-random-string
BH_JWT_ALGORITHM=HS256
BH_ACCESS_TOKEN_TTL_MINUTES=30
BH_REFRESH_TOKEN_TTL_DAYS=30

# Geo / H3
BH_H3_RESOLUTION=8
BH_DEFAULT_SEARCH_RADIUS_M=1000
BH_MAX_SEARCH_RADIUS_M=50000
BH_MAX_GRID_DISK_K=50

# Pagination
BH_DEFAULT_PAGE_SIZE=10
BH_MAX_PAGE_SIZE=100

# Granian (Rust ASGI server)
GRANIAN_WORKERS=1
GRANIAN_LOG_LEVEL=info
GRANIAN_LOG_ACCESS_ENABLED=false
