BH_ENVIRONMENT=development
BH_DEBUG=true

# PostgreSQL / PostGIS connection (asyncpg uses this directly)
BH_DATABASE_URL=postgresql://bloodheroes:bloodheroes@localhost:5432/bloodheroes
BH_DB_POOL_MIN=1
BH_DB_POOL_MAX=10

# JWT
BH_JWT_SECRET=change-me-to-a-long-random-string
BH_JWT_ALGORITHM=HS256
BH_ACCESS_TOKEN_TTL_MINUTES=30
BH_REFRESH_TOKEN_TTL_DAYS=30

# Geo / H3
BH_H3_RESOLUTION=8
BH_DEFAULT_SEARCH_RADIUS_M=1000
BH_MAX_SEARCH_RADIUS_M=50000
BH_MAX_GRID_DISK_K=50

# Pagination
BH_DEFAULT_PAGE_SIZE=10
BH_MAX_PAGE_SIZE=100

# Comma-separated browser origins allowed to call the API (empty = no CORS)
BH_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# App token shared by the web apps via their server-side proxy.
# The default below is seeded by migrations/0003_seed_app_token.sql.
# Rotate it in production and update BH_APP_TOKEN for dashboard/client.
BH_APP_TOKEN=dev-app-token-change-me

# Dev operator seed (scripts/seed_dev_operator.py, `make seed-dev`).
# Dev-only defaults; rotate for any shared environment.
SEED_OPERATOR_EMAIL=ops@example.com
SEED_OPERATOR_PASSWORD=password123
# SEED_ALLOW_PRODUCTION=1  # required to run the seed under BH_ENVIRONMENT=production

# Granian (Rust ASGI server)
GRANIAN_WORKERS=1
GRANIAN_LOG_LEVEL=info
GRANIAN_LOG_ACCESS_ENABLED=false
